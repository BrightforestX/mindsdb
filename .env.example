# MindsDB Configuration
# Copy to .env and adjust as needed.

# Storage
# MINDSDB_STORAGE_DIR=

# Logging levels
# MINDSDB_LOG_LEVEL=INFO
# MINDSDB_CONSOLE_LOG_LEVEL=INFO
# MINDSDB_FILE_LOG_LEVEL=INFO

# Firebase / Google Cloud Logging (Cloud Logging + Error Reporting)
# Required for Cloud Logging; also used for Firebase project context.
FIREBASE_PROJECT_ID=
# Path to service account JSON for GCP/Firebase authentication.
# Leave empty to use Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=
# Enable Cloud Logging handler (set to 1 or true).
CLOUD_LOGGING_ENABLED=false
# Cloud Logging minimum level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# CLOUD_LOGGING_LEVEL=INFO

# Sentry (optional)
# SENTRY_IO_DSN=
# SENTRY_IO_ENVIRONMENT=local
# SENTRY_IO_RELEASE=
